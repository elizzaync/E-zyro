# Plantilla de variables de entorno de E-zyro (BACKEND).
# Copia este archivo a `.env` y rellena los valores REALES localmente.
# NUNCA subas el .env real al repositorio (ya está en .gitignore).
# En producción, define estas variables en el panel de Railway, no en un archivo.

# ── Seguridad / JWT ───────────────────────────────────────────────────────────
# Clave de firma de los JWT. Debe ser larga y aleatoria (p. ej. `openssl rand -hex 32`).
SECRET_KEY=

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=

# ── Correo (SMTP) ─────────────────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_PORT=
MAIL_SERVER=

# ── Cloudinary (almacenamiento de imágenes/archivos) ──────────────────────────
CLOUD_NAME_CLOUDINARY=
API_KEY_CLOUDINARY=
API_SECRET_CLOUDINARY=

# ── Chatbot / IA (Ollama) ─────────────────────────────────────────────────────
CHATBOT_PROVIDER=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# ── CORS (opcional) ───────────────────────────────────────────────────────────
# Lista de orígenes permitidos separada por comas, p. ej.:
#   CORS_ORIGINS=https://tu-frontend.up.railway.app,https://app.tudominio.com
# Si se deja vacío, el backend usa un regex que acepta *.railway.app y localhost.
CORS_ORIGINS=
