<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono monocromático para la barra de estado (status bar).
     Android solo usa el canal alfa: forma blanca sobre transparente.
     Evoca la marca E-Zyro: anillo con grupo de celdas hexagonales. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Anillo exterior (dos semicírculos para un trazo cerrado robusto) -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:fillColor="#00000000"
        android:pathData="M12,2.6 A9.4,9.4 0 1 0 12,21.4 A9.4,9.4 0 1 0 12,2.6 Z" />

    <!-- Celda central -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,10.4 l1.55,0.9 v1.8 l-1.55,0.9 -1.55,-0.9 v-1.8 z" />

    <!-- Celda superior -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,6.6 l1.55,0.9 v1.8 l-1.55,0.9 -1.55,-0.9 v-1.8 z" />

    <!-- Celda inferior -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,14.2 l1.55,0.9 v1.8 l-1.55,0.9 -1.55,-0.9 v-1.8 z" />

    <!-- Celda izquierda -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.7,12.3 l1.55,0.9 v1.8 l-1.55,0.9 -1.55,-0.9 v-1.8 z" />

    <!-- Celda derecha -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.3,12.3 l1.55,0.9 v1.8 l-1.55,0.9 -1.55,-0.9 v-1.8 z" />
</vector>
